{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":gitSignOff",
    ":ignoreModulesAndTests",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":semanticPrefixFixDepsChoreOthers",
    "replacements:all",
    "workarounds:all"
  ],
  "assigneesFromCodeOwners": true,
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "Use fix(deps) for cargo package updates",
      "matchManagers": ["cargo"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Use fix(deps) for dependencies shipped within a composite GitHub action",
      "matchFileNames": ["action.yml", "action.yaml"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Describe the full version change in single-dependency commit subjects",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "commitMessageExtra": "{{#if currentVersion}}from {{{currentVersion}}} {{/if}}to {{#if newVersion}}{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}"
    }
  ]
}
